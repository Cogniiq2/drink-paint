# BoLaGio Atelier — environment variables
#
# Local development (Next.js):   cp .env.example .env.local
# Cloudflare Workers:            see docs/CLOUDFLARE.md
#   - "BUILD" variables are read while `npm run build:cf` runs (set them under
#     Workers Builds -> Build variables and secrets) and are inlined into the bundle.
#   - "RUNTIME" variables are Worker variables/secrets (Settings -> Variables and Secrets).
#   - NEXT_PUBLIC_SITE_URL is needed in BOTH places and must be identical.
#
# Never commit real values. This file contains placeholders only.

# ── Site ────────────────────────────────────────────────────────────────────
# BUILD + RUNTIME. Production origin without trailing slash, e.g. https://www.example.de
# Leave as localhost for local development: it is also what enables the local-only payment simulator.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Launch safety ───────────────────────────────────────────────────────────  (RUNTIME)
# Until "true", the site is public but no Stripe Checkout session can be created.
PUBLIC_SALES_ENABLED=false
VOUCHERS_ENABLED=false
TESTIMONIALS_ENABLED=false
# BUILD. Switch on once /public/media/hero-film.mp4 exists.
NEXT_PUBLIC_HERO_FILM_ENABLED=false

# ── Inventory ───────────────────────────────────────────────────────────────  (RUNTIME)
# Stripe Checkout sessions expire after a minimum of 30 minutes, so the hold
# mirrors that by default. See docs/ARCHITECTURE.md §4 for shorter holds.
HOLD_MINUTES=30

# ── Supabase ────────────────────────────────────────────────────────────────  (RUNTIME; key = secret)
# Server only — never prefix with NEXT_PUBLIC.
# Leave empty to run with the in-memory demo store (local development ONLY:
# on Cloudflare Workers the demo store is per-isolate and must not be used).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ──────────────────────────────────────────────────────────────────  (RUNTIME; both secrets)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email (Resend). Empty = development outbox logged to the console. ───────  (RUNTIME; key = secret)
RESEND_API_KEY=
EMAIL_FROM="BoLaGio Atelier <tickets@example.com>"
EMAIL_REPLY_TO=
PRIVATE_EVENTS_RECIPIENT=
ADMIN_NOTIFICATION_EMAIL=

# ── Cron ────────────────────────────────────────────────────────────────────  (RUNTIME; secret)
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" (vercel.json).
# On Cloudflare the Worker's scheduled() handler (worker/index.ts) sends the same header internally.
# Min 16 chars. Generate with: openssl rand -hex 24
CRON_SECRET=

# ── Admin ───────────────────────────────────────────────────────────────────  (RUNTIME; both secrets)
# Password min 12 chars. Generate the secret with: openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── Analytics (none | console | plausible | meta) ────────────────────────────  (BUILD)
# "console" logs events locally without consent requirements.
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
# Only when the provider is "meta" (BUILD).
NEXT_PUBLIC_META_PIXEL_ID=
