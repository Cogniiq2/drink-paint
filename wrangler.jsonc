{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard (Workers & Pages -> your Worker).
  "name": "drink-paint",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare Images binding used by next/image (/_next/image). No dashboard setup required.
  "images": { "binding": "IMAGES" },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  // Replaces the hourly Vercel cron in vercel.json (UTC). Needs the CRON_SECRET secret.
  "triggers": { "crons": ["0 * * * *"] },
  // Dashboard-managed plain-text variables survive `wrangler deploy`. Secrets are never touched.
  "keep_vars": true,
  "observability": { "enabled": true }
}
